      "id": 201,
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"multicloud_cost\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"cloud_cost\" and r._field == \"amount\") |> drop(columns: [\"_start\", \"_stop\"]) |> aggregateWindow(every: 1d, fn: sum, createEmpty: false) |> keep(columns: [\"_time\", \"_value\", \"cloud\"]) |> pivot(rowKey: [\"_time\"], columnKey: [\"cloud\"], valueColumn: \"_value\")",
