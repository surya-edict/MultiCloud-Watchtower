    {
      "type": "table",
      "title": "Latest Resource Spend",
      "id": 205,
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "targets": [
        {
          "query": "from(bucket: \"multicloud_cost\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"cloud_cost\" and (r._field == \"amount\" or r._field == \"tax_amount\")) |> drop(columns: [\"_start\", \"_stop\"]) |> group(columns: [\"cloud\", \"service\", \"account_id\", \"region\"]) |> last() |> pivot(rowKey: [\"_time\", \"cloud\", \"service\", \"region\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> group() |> sort(columns: [\"amount\"], desc: true) |> limit(n: 10) |> keep(columns: [\"_time\", \"cloud\", \"service\", \"region\", \"amount\", \"tax_amount\"]) |> rename(columns: {_time: \"Time\", cloud: \"Cloud\", service: \"Service\", region: \"Region\", amount: \"Spend\", tax_amount: \"Tax\"})",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Spend" }]
