APP_ENV=development
LOG_LEVEL=INFO
CLOUD_MODE=mock
ALLOW_MOCK_FALLBACK=true

SCHEDULER_HOURLY_INTERVAL_MINUTES=60
SCHEDULER_DAILY_AT=09:00

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=change-me
INFLUXDB_ORG=devops-lab
INFLUXDB_BUCKET=multicloud_cost
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-influx-admin-password

REDIS_URL=redis://redis:6379/0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

SLACK_WEBHOOK_URL=

ALERT_COST_THRESHOLD=500
ALERT_SPIKE_PERCENTAGE=20
ALERT_DEDUPE_HOURS=12

RECOMMENDATION_LOW_UTILIZATION_PCT=20
RECOMMENDATION_HIGH_COST_THRESHOLD=100

# Global Tax & Compliance Engine
# Apply local taxes like GST/VAT to your compute resources. (0.0 = Disabled)
GLOBAL_TAX_RATE_PCT=18.0
# Apply compliance notional costs to free-tier/exempt resources (e.g. India's Rule 14)
APPLY_NOTIONAL_COST=true
NOTIONAL_COST_PCT=1.0

AWS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GCP_ENABLED=true
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
GCP_BIGQUERY_TABLE=project.dataset.gcp_billing_export_v1
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp.json

AZURE_ENABLED=true
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
